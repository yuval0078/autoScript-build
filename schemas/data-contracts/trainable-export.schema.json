{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schemas/data-contracts/trainable-export.schema.json",
  "title": "Analyzer trainable JSON as currently emitted",
  "description": "One participant is emitted as an object; multiple participants are emitted as an array.",
  "oneOf": [
    {
      "$ref": "#/$defs/participant"
    },
    {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/participant"
      }
    }
  ],
  "$defs": {
    "participant": {
      "type": "object",
      "required": [
        "participant_number",
        "participant_age",
        "participant_gender",
        "timestamp",
        "calibration",
        "group",
        "words"
      ],
      "properties": {
        "participant_number": {
          "type": [
            "integer",
            "string"
          ]
        },
        "participant_age": {
          "type": [
            "integer",
            "number",
            "string",
            "null"
          ]
        },
        "participant_gender": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": "string"
        },
        "calibration": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/calibration"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {}
            }
          ]
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trainableWord"
          }
        }
      },
      "additionalProperties": true
    },
    "trainableWord": {
      "type": "object",
      "required": [
        "written_word",
        "trainability",
        "audio_start_time",
        "audio_end_time",
        "strokes",
        "letters"
      ],
      "properties": {
        "written_word": {
          "type": "string"
        },
        "trainability": {
          "type": "string",
          "enum": [
            "trainable",
            "low-quality",
            "untrainable"
          ]
        },
        "audio_start_time": {
          "type": [
            "number",
            "null"
          ]
        },
        "audio_end_time": {
          "type": [
            "number",
            "null"
          ]
        },
        "strokes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stroke"
          }
        },
        "letters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/letter"
          }
        }
      },
      "additionalProperties": true
    },
    "stroke": {
      "type": "object",
      "required": [
        "stroke_id",
        "events"
      ],
      "properties": {
        "stroke_id": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/penEvent"
          }
        }
      },
      "additionalProperties": true
    },
    "letter": {
      "type": "object",
      "required": [
        "char",
        "stroke_ids"
      ],
      "properties": {
        "char": {
          "type": "string"
        },
        "stroke_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": true
    }
  }
}
