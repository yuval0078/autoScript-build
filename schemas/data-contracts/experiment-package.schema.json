{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schemas/data-contracts/experiment-package.schema.json",
  "title": "Builder experiment JSON as currently emitted inside the ZIP",
  "type": "object",
  "required": [
    "app_version",
    "name",
    "grid",
    "order",
    "sequence",
    "repetitions",
    "active_block_sequence",
    "proceed_condition",
    "beeps",
    "files",
    "groups"
  ],
  "properties": {
    "app_version": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "grid": {
      "type": "object",
      "required": [
        "rows",
        "cols"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "cols": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "order": {
      "type": "string",
      "enum": [
        "stiff",
        "random"
      ]
    },
    "sequence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repetitions": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "active_block_sequence": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "integer",
            "minimum": 1
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "proceed_condition": {
      "type": "object",
      "required": [
        "type",
        "delay_ms"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "key",
            "time"
          ]
        },
        "delay_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "beeps": {
      "type": "object",
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "$ref": "#/$defs/beep"
        },
        "after": {
          "$ref": "#/$defs/beep"
        }
      },
      "additionalProperties": true
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mediaFile"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    }
  },
  "$defs": {
    "beep": {
      "type": "object",
      "required": [
        "enabled",
        "delay_ms"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "delay_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "mediaFile": {
      "type": "object",
      "required": [
        "file_name",
        "path",
        "original_name",
        "owner_group",
        "auto_slice_word"
      ],
      "properties": {
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^media/[^/]+$"
        },
        "original_name": {
          "type": "string",
          "minLength": 1
        },
        "owner_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "auto_slice_word": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "group": {
      "type": "object",
      "required": [
        "name",
        "words"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/word"
          }
        }
      },
      "additionalProperties": true
    },
    "word": {
      "type": "object",
      "required": [
        "id",
        "text",
        "source_file",
        "start_ms",
        "end_ms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "start_ms": {
          "type": "number",
          "minimum": 0
        },
        "end_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
