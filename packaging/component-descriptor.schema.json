{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoscript.local/schemas/component-descriptor.schema.json",
  "title": "AutoScript independently installed component descriptor",
  "type": "object",
  "required": [
    "format_version",
    "id",
    "version",
    "platform",
    "arch",
    "entrypoint",
    "protocol_version",
    "source_commit"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "id": {
      "enum": ["interface", "builder", "runner", "analyzer"]
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*)){1,3}$"
    },
    "platform": { "const": "windows" },
    "arch": { "enum": ["x86_64", "amd64"] },
    "entrypoint": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.exe$"
    },
    "protocol_version": { "type": "integer", "minimum": 1 },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "additionalProperties": false
}
