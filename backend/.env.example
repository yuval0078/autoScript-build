AUTOSCRIPT_ENVIRONMENT=development
AUTOSCRIPT_DATABASE_URL=postgresql+psycopg://autoscript:change-me@localhost:5432/autoscript
AUTOSCRIPT_MINIO_ENDPOINT=localhost:9000
AUTOSCRIPT_MINIO_ACCESS_KEY=autoscript
AUTOSCRIPT_MINIO_SECRET_KEY=change-me
AUTOSCRIPT_MINIO_BUCKET=autoscript-artifacts
AUTOSCRIPT_MINIO_SECURE=false
AUTOSCRIPT_LOCAL_ACTOR_USERNAME=local-admin
AUTOSCRIPT_AUTH_MODE=local
AUTOSCRIPT_ACCESS_TOKEN_TTL_HOURS=24
AUTOSCRIPT_BOOTSTRAP_ADMIN_USERNAME=admin
# Required when AUTOSCRIPT_AUTH_MODE=token; use a long random secret.
AUTOSCRIPT_BOOTSTRAP_ADMIN_PASSWORD=
AUTOSCRIPT_MAX_UPLOAD_BYTES=536870912
AUTOSCRIPT_MAX_UNCOMPRESSED_PACKAGE_BYTES=2147483648
AUTOSCRIPT_STAGED_BLOCK_TTL_HOURS=24
AUTOSCRIPT_LOGIN_RATE_LIMIT_ATTEMPTS=5
AUTOSCRIPT_LOGIN_RATE_LIMIT_ADDRESS_MULTIPLIER=4
AUTOSCRIPT_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
AUTOSCRIPT_LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900
AUTOSCRIPT_SECURITY_STATE_RETENTION_DAYS=30
AUTOSCRIPT_ANALYSIS_DRAFT_RETENTION=20

POSTGRES_DB=autoscript
POSTGRES_USER=autoscript
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=autoscript
MINIO_ROOT_PASSWORD=change-me
AUTOSCRIPT_API_PORT=8000
